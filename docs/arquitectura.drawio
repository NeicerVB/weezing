        </mxCell>
        <mxCell id="cw" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #581C87;&quot;&gt;Log Group: /aws/ecs/default/spookython-web-14ac&lt;br&gt;&amp;bull; Logs stdout/stderr de FastAPI&lt;br&gt;&amp;bull; Trazas y métricas de AWS Lambda&lt;br&gt;&amp;bull; Auditoría con CloudTrail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="sub_ops">
          <mxGeometry x="25" y="160" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="iam" value="&lt;b&gt;AWS IAM (Mínimo Privilegio)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #581C87;&quot;&gt;&amp;bull; &lt;b&gt;ecsTaskExecutionRole:&lt;/b&gt; Pull ECR + Logs CW&lt;br&gt;&amp;bull; &lt;b&gt;ecsInfrastructureRole:&lt;/b&gt; ALB y VPC Discovery&lt;br&gt;&amp;bull; &lt;b&gt;ECS Task Policy:&lt;/b&gt; states:StartSyncExecution&lt;br&gt;&amp;bull; &lt;b&gt;Step Functions Policy:&lt;/b&gt; lambda:InvokeFunction&lt;br&gt;&amp;bull; Aislado sin credenciales humanas en código&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="sub_ops">
          <mxGeometry x="25" y="290" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="budget" value="&lt;b&gt;AWS Budgets&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #92400E;&quot;&gt;&amp;bull; Límite de control: USD 5,00 / mes&lt;br&gt;&amp;bull; Alerta de correo electrónico configurada&lt;br&gt;&amp;bull; Estimación operativa: ~USD 1,20 / día&lt;br&gt;&amp;bull; Auditoría activa de costos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="sub_ops">
          <mxGeometry x="25" y="450" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="verification" value="&lt;b&gt;Verificación y Rendimiento (Benchmarking)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;&amp;bull; 115 tests automatizados (pytest): 100% OK&lt;br&gt;&amp;bull; Simulación individual: p95 &amp;lt; 0.73 s&lt;br&gt;&amp;bull; Monte Carlo 30 réplicas (AWS): &amp;lt; 3.0 s&lt;br&gt;&amp;bull; Fallback local throttled: 37.9 s&lt;br&gt;&amp;bull; Evidencias en docs/*.json y dictamen-aws.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="sub_ops">

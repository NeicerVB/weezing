        <mxCell id="fastapi" value="&lt;b&gt;Servidor Web FastAPI / Uvicorn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #1E3A8A;&quot;&gt;Puerto 8000 | 256 CPU / 512 MiB&lt;br&gt;&lt;b&gt;Endpoints:&lt;/b&gt; /, /health, /api/simulate, /api/batch&lt;br&gt;Gestión de CORS y Archivos Estáticos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;fontColor=#0F172A;" vertex="1" parent="sub_ecs">
          <mxGeometry x="25" y="45" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="seir_engine" value="&lt;b&gt;Motor Epidemiológico SEIR (Local)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;&amp;bull; &lt;b&gt;Topología:&lt;/b&gt; 7 Sectores, 14 Puentes Inter-sectoriales&lt;br&gt;&amp;bull; &lt;b&gt;Dinámica:&lt;/b&gt; Estados S-E-I-R con Probabilidad Estocástica&lt;br&gt;&amp;bull; &lt;b&gt;Estrategias:&lt;/b&gt; Ninguna, Aleatoria, Propuesta de Grados&lt;br&gt;&amp;bull; &lt;b&gt;Voluntarios:&lt;/b&gt; Brigadas activas y reinfección&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontSize=11;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="sub_ecs">
          <mxGeometry x="25" y="160" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="process_pool" value="&lt;b&gt;ProcessPoolExecutor (Local Fallback)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #92400E;&quot;&gt;Ejecución multi-proceso de réplicas en local&lt;br&gt;Respaldo automático si la nube no está activa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;fontColor=#0F172A;strokeWidth=1;strokeDasharray=3 3;" vertex="1" parent="sub_ecs">
          <mxGeometry x="25" y="315" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="health_check" value="&lt;b&gt;Health Check (/health)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #047857;&quot;&gt;Intervalo 30s | Monitoreo ALB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=11;fontColor=#064E3B;" vertex="1" parent="sub_ecs">
          <mxGeometry x="25" y="410" width="380" height="40" as="geometry" />
        </mxCell>

        <!-- SUBZONA: SERVERLESS MONTE CARLO -->
        <mxCell id="sub_serverless" value="Cómputo Distribuido Monte Carlo (AWS Step Functions + Lambda)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#2DD4BF;fontStyle=1;fontSize=13;fontColor=#0F766E;rounded=1;" vertex="1" parent="zone_aws">
          <mxGeometry x="30" y="550" width="710" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sfn" value="&lt;b&gt;Step Functions Express&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #115E59;&quot;&gt;Spookython-Simulation-Express&lt;br&gt;Invocación Sync (StartSyncExecution)&lt;br&gt;Lógica JSONata Declarativa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontSize=12;fontColor=#0F172A;" vertex="1" parent="sub_serverless">
          <mxGeometry x="20" y="45" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sfn_map" value="&lt;b&gt;Estado Inline Map&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #115E59;&quot;&gt;Paralelismo con concurrencia 10&lt;br&gt;Distribución de semillas (seed+i)&lt;br&gt;Lanza N réplicas simultáneas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontSize=12;fontColor=#0F172A;" vertex="1" parent="sub_serverless">
          <mxGeometry x="320" y="45" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lambda_worker" value="&lt;b&gt;AWS Lambda Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #115E59;&quot;&gt;Spookython-MonteCarlo-Worker&lt;br&gt;Python 3.12 (Paquete SEIR Linux)&lt;br&gt;Simulación Monte Carlo aislada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontSize=12;fontColor=#0F172A;" vertex="1" parent="sub_serverless">
          <mxGeometry x="20" y="185" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sfn_reduce" value="&lt;b&gt;Tarea de Agregación (Reduce)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #115E59;&quot;&gt;Consolidación de métricas de réplicas:&lt;br&gt;Media, p2.5, p97.5, Mínimo y Máximo&lt;br&gt;Retorno ultra-rápido en una sola carga&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontSize=12;fontColor=#0F172A;" vertex="1" parent="sub_serverless">
          <mxGeometry x="320" y="185" width="360" height="110" as="geometry" />
        </mxCell>

        <!-- SUBZONA: GOBERNANZA, SEGURIDAD Y OPERACIONES -->
